<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Liquid glass disc -->
    <path
        android:pathData="M54,20 a34,34 0 1,0 0.01,0 z"
        android:fillColor="#38FFFFFF" />
    <path
        android:pathData="M54,20 a34,34 0 1,0 0.01,0 z"
        android:strokeColor="#5CFFFFFF"
        android:strokeWidth="1.4" />

    <!-- Specular highlight, top-left of the disc -->
    <path
        android:pathData="M33,42 A29,29 0 0 1 47,27"
        android:strokeColor="#8CFFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M28.5,50 A29,29 0 0 1 31,42.5"
        android:strokeColor="#59FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Calendar square inside the disc -->
    <path
        android:pathData="M48,41 h12 a7,7 0 0 1 7,7 v12 a7,7 0 0 1 -7,7 h-12 a7,7 0 0 1 -7,-7 v-12 a7,7 0 0 1 7,-7 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="41" android:startY="41"
                android:endX="67" android:endY="67"
                android:type="linear">
                <item android:offset="0" android:color="#F2FFFFFF" />
                <item android:offset="1" android:color="#D8FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glass sheen across the square's upper half -->
    <path
        android:pathData="M43,52 L56,41 h3 L43,57.5 z"
        android:fillColor="#4DFFFFFF" />

    <!-- Calendar header strip + date dots (expressive accent) -->
    <path
        android:pathData="M41,47 h26 v2 h-26 z"
        android:fillColor="#666750A4" />
    <path
        android:pathData="M47,53 h4 v4 h-4 z M53,53 h4 v4 h-4 z"
        android:fillColor="#6750A4" />
</vector>
